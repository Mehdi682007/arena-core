{
  "name": "@arena-core/config",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "types": "./src/index.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist tsconfig.build.tsbuildinfo && tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "semver": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arena-core/eslint-config": "workspace:*",
    "@arena-core/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "eslint": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
