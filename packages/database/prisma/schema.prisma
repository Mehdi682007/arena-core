enum MatchEvidenceType {
  SCREENSHOT_DECLARATION
  VIDEO_DECLARATION
  MATCH_SUMMARY_DECLARATION
  TEXT_STATEMENT

  @@map("match_evidence_type")
}

enum MatchEvidenceStatus {
