model PlayerRatingChange {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerRatingId       String                 @map("player_rating_id") @db.Uuid
  ratingApplicationId  String                 @map("rating_application_id") @db.Uuid
  matchId              String                 @map("match_id") @db.Uuid
  matchResultId        String                 @map("match_result_id") @db.Uuid
  userId               String                 @map("user_id") @db.Uuid
  opponentUserId       String                 @map("opponent_user_id") @db.Uuid
  outcome              RatingOutcome
  ratingBefore         Int                    @map("rating_before")
  ratingAfter          Int                    @map("rating_after")
  ratingDelta          Int                    @map("rating_delta")
  opponentRatingBefore Int                    @map("opponent_rating_before")
  policyKey            String                 @map("policy_key") @db.VarChar(32)
  policyVersion        Int                    @map("policy_version")
  calculationSnapshot  Json                   @map("calculation_snapshot")
  appliedAt            DateTime               @map("applied_at") @db.Timestamptz(3)
  reversedAt           DateTime?              @map("reversed_at") @db.Timestamptz(3)
  version              Int                    @default(1)
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  playerRating         PlayerRating           @relation(fields: [playerRatingId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "player_rating_changes_rating_id_fkey")
  ratingApplication    MatchRatingApplication @relation(fields: [ratingApplicationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "player_rating_changes_application_id_fkey")
  match                Match                  @relation(fields: [matchId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "player_rating_changes_match_id_fkey")
  user                 User                   @relation("RatingChangeUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "player_rating_changes_user_id_fkey")
  opponent             User                   @relation("RatingChangeOpponent", fields: [opponentUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "player_rating_changes_opponent_id_fkey")

  @@unique([matchId, userId], map: "player_rating_changes_match_user_key")
  @@index([playerRatingId, appliedAt], map: "player_rating_changes_rating_applied_idx")
  @@index([userId, appliedAt], map: "player_rating_changes_user_applied_idx")
  @@index([ratingApplicationId], map: "player_rating_changes_application_idx")
  @@map("player_rating_changes")
}

model Notification {
  id               String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientUserId  String                      @map("recipient_user_id") @db.Uuid
  type             NotificationType
  schemaVersion    Int                         @map("schema_version")
  priority         NotificationPriority        @default(NORMAL)
  locale           String                      @db.VarChar(5)
  subject          String                      @db.VarChar(200)
  body             String                      @db.VarChar(2000)
  payload          Json
  sourceType       String                      @map("source_type") @db.VarChar(40)
  sourceId         String                      @map("source_id") @db.VarChar(128)
  deduplicationKey String                      @unique(map: "notifications_deduplication_key") @map("deduplication_key") @db.VarChar(64)
  payloadHash      String                      @map("payload_hash") @db.Char(64)
  createdAt        DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt           DateTime?                   @map("read_at") @db.Timestamptz(3)
  archivedAt       DateTime?                   @map("archived_at") @db.Timestamptz(3)
  expiresAt        DateTime?                   @map("expires_at") @db.Timestamptz(3)
  version          Int                         @default(1)
  updatedAt        DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  recipient        User                        @relation(fields: [recipientUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "notifications_recipient_id_fkey")
  outboxMessages   NotificationOutboxMessage[]

  @@index([recipientUserId, createdAt(sort: Desc), id], map: "notifications_recipient_created_idx")
  @@index([recipientUserId, readAt], map: "notifications_recipient_read_idx")
  @@index([recipientUserId, archivedAt], map: "notifications_recipient_archived_idx")
  @@index([type, createdAt], map: "notifications_type_created_idx")
  @@index([sourceType, sourceId], map: "notifications_source_idx")
  @@index([expiresAt], map: "notifications_expires_idx")
  @@map("notifications")
}

model NotificationPreference {
