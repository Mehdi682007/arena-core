  OTHER

  @@map("match_dispute_reason_code")
}

enum DisputeResolutionType {
  UPHOLD_RESULT
  CORRECT_RESULT
  VOID_MATCH
  REJECT_DISPUTE

  @@map("dispute_resolution_type")
}

enum MatchResultSubmissionStatus {
  ACTIVE
  WITHDRAWN
  SUPERSEDED
  CONFIRMED
  CONFLICTING

  @@map("match_result_submission_status")
}

enum MatchResultStatus {
  CONFIRMED
  CONFLICT
  ADMIN_RESOLVED
  VOIDED

  @@map("match_result_status")
}

enum MatchResultConfirmationMethod {
  PARTICIPANT_AGREEMENT
  ADMIN_RESOLUTION

  @@map("match_result_confirmation_method")
}

enum MatchResultConflictReason {
