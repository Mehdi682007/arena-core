  ledgerAccount             LedgerAccount?               @relation("MatchEntryUserAccount", fields: [ledgerAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  escrowAccount             LedgerAccount?               @relation("MatchEntryEscrowAccount", fields: [escrowAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ledgerTransaction         LedgerTransaction?           @relation("MatchEntryReservationTransaction", fields: [ledgerTransactionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  refundLedgerTransaction   LedgerTransaction?           @relation("MatchEntryRefundTransaction", fields: [refundLedgerTransactionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  settlement                MatchSettlement?             @relation(fields: [settlementId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([matchId, participantId], map: "match_entry_reservations_match_participant_key")
  @@index([userId, createdAt], map: "match_entry_reservations_user_created_idx")
  @@index([matchId, status], map: "match_entry_reservations_match_status_idx")
  @@index([status, expiresAt], map: "match_entry_reservations_status_expires_idx")
  @@index([escrowAccountId], map: "match_entry_reservations_escrow_account_idx")
  @@index([settlementId], map: "match_entry_reservations_settlement_idx")
  @@map("match_entry_reservations")
}

model MatchSettlement {
  id                      String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId                 String                  @unique(map: "match_settlements_match_id_key") @map("match_id") @db.Uuid
  assetCode               String                  @map("asset_code") @db.VarChar(32)
  status                  MatchSettlementStatus
  type                    MatchSettlementType
  totalEscrowAmount       BigInt                  @map("total_escrow_amount")
  distributedAmount       BigInt                  @map("distributed_amount")
  refundedAmount          BigInt                  @map("refunded_amount")
  retainedAmount          BigInt                  @default(0) @map("retained_amount")
  winnerParticipantId     String?                 @map("winner_participant_id") @db.Uuid
  resultId                String?                 @map("result_id") @db.Uuid
  disputeId               String?                 @map("dispute_id") @db.Uuid
  idempotencyKey          String                  @unique(map: "match_settlements_idempotency_key") @map("idempotency_key") @db.VarChar(128)
  requestFingerprint      String                  @map("request_fingerprint") @db.Char(64)
  settlementTransactionId String?                 @unique(map: "match_settlements_transaction_id_key") @map("settlement_transaction_id") @db.Uuid
  settledAt               DateTime?               @map("settled_at") @db.Timestamptz(3)
  failedAt                DateTime?               @map("failed_at") @db.Timestamptz(3)
  failureCode             String?                 @map("failure_code") @db.VarChar(64)
  version                 Int                     @default(1)
  createdAt               DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  match                   Match                   @relation(fields: [matchId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "match_settlements_match_id_fkey")
  winnerParticipant       MatchParticipant?       @relation("MatchSettlementWinner", fields: [winnerParticipantId, matchId], references: [id, matchId], onDelete: Restrict, onUpdate: Cascade, map: "match_settlements_winner_match_fkey")
  result                  MatchResult?            @relation(fields: [resultId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "match_settlements_result_id_fkey")
  dispute                 MatchDispute?           @relation(fields: [disputeId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "match_settlements_dispute_id_fkey")
  settlementTransaction   LedgerTransaction?      @relation(fields: [settlementTransactionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "match_settlements_transaction_id_fkey")
  reservations            MatchEntryReservation[]

  @@index([resultId], map: "match_settlements_result_idx")
  @@index([disputeId], map: "match_settlements_dispute_idx")
  @@index([status, createdAt], map: "match_settlements_status_created_idx")
  @@index([type], map: "match_settlements_type_idx")
  @@index([winnerParticipantId], map: "match_settlements_winner_idx")
  @@index([settledAt], map: "match_settlements_settled_idx")
  @@map("match_settlements")
}

model PlayerRating {
  id                       String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                   String               @map("user_id") @db.Uuid
  gameId                   String               @map("game_id") @db.Uuid
  gameModeId               String               @map("game_mode_id") @db.Uuid
  crossplayGroupId         String               @map("crossplay_group_id") @db.Uuid
  policyKey                String               @map("policy_key") @db.VarChar(32)
  policyVersion            Int                  @map("policy_version")
  rating                   Int
  matchesPlayed            Int                  @default(0) @map("matches_played")
  wins                     Int                  @default(0)
  losses                   Int                  @default(0)
  draws                    Int                  @default(0)
  provisionalMatchesPlayed Int                  @default(0) @map("provisional_matches_played")
  highestRating            Int                  @map("highest_rating")
  lowestRating             Int                  @map("lowest_rating")
  lastMatchId              String?              @map("last_match_id") @db.Uuid
  version                  Int                  @default(1)
  createdAt                DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                     User                 @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "player_ratings_user_id_fkey")
  game                     Game                 @relation(fields: [gameId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "player_ratings_game_id_fkey")
  gameMode                 GameMode             @relation(fields: [gameModeId, gameId], references: [id, gameId], onDelete: Restrict, onUpdate: Cascade, map: "player_ratings_mode_game_fkey")
  crossplayGroup           CrossplayGroup       @relation(fields: [crossplayGroupId, gameId], references: [id, gameId], onDelete: Restrict, onUpdate: Cascade, map: "player_ratings_crossplay_game_fkey")
  changes                  PlayerRatingChange[]

  @@unique([userId, gameId, gameModeId, crossplayGroupId, policyKey, policyVersion], map: "player_ratings_scope_key")
  @@index([userId], map: "player_ratings_user_idx")
  @@index([gameId, gameModeId, crossplayGroupId, policyKey, policyVersion, rating(sort: Desc), matchesPlayed(sort: Desc), wins(sort: Desc), updatedAt, id], map: "player_ratings_leaderboard_idx")
  @@index([updatedAt], map: "player_ratings_updated_idx")
  @@map("player_ratings")
}

