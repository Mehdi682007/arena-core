generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BANNED
  DISABLED
  DELETED

  @@map("user_status")
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED

  @@map("session_status")
}

enum PhoneOtpPurpose {
  SIGN_IN
  VERIFY_PHONE
  CHANGE_PHONE
  RECOVERY

  @@map("phone_otp_purpose")
}

enum GameStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("game_status")
}

enum PlatformFamily {
  PLAYSTATION
  XBOX
  PC
  NINTENDO
  MOBILE
  OTHER

  @@map("platform_family")
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("catalog_status")
}

enum GameModeStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("game_mode_status")
}

enum GameRulesetStatus {
