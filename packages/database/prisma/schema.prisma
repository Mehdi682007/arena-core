}

enum LedgerAccountType {
  USER_AVAILABLE
  SYSTEM_ISSUANCE
  SYSTEM_ADJUSTMENT
  MATCH_ESCROW

  @@map("ledger_account_type")
}

enum LedgerAccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED

  @@map("ledger_account_status")
}

enum LedgerTransactionType {
  ISSUANCE
  ADMIN_ADJUSTMENT
  REVERSAL
  MATCH_ENTRY_RESERVATION
  MATCH_ENTRY_REFUND
  MATCH_WINNER_SETTLEMENT
  MATCH_DRAW_REFUND
  MATCH_VOID_REFUND

  @@map("ledger_transaction_type")
}

enum LedgerTransactionStatus {
  POSTED
  REVERSED

  @@map("ledger_transaction_status")
}

enum LedgerEntryDirection {
  DEBIT
  CREDIT

  @@map("ledger_entry_direction")
}

enum WalletAuditAction {
  WALLET_CREATED
  POINTS_ISSUED
  BALANCE_ADJUSTED
  TRANSACTION_REVERSED
  RECONCILIATION_CHECKED
  RECONCILIATION_MISMATCH

  @@map("wallet_audit_action")
}

enum MatchEntryReservationStatus {
  NOT_REQUIRED
  RESERVED
  RELEASED
  REFUNDED
  CANCELLED
  EXPIRED
  FAILED
  SETTLED

  @@map("match_entry_reservation_status")
}

enum MatchEntrySettlementOutcome {
  WINNER_CREDITED
  LOSER_CONTRIBUTED
  DRAW_REFUNDED
  VOID_REFUNDED

  @@map("match_entry_settlement_outcome")
}

enum MatchSettlementStatus {
  PENDING
  SETTLED
  REFUNDED
  VOIDED
  FAILED

  @@map("match_settlement_status")
}

enum MatchSettlementType {
  WINNER_TAKES_ALL
  DRAW_REFUND
  VOID_REFUND
  ADMIN_CORRECTION

  @@map("match_settlement_type")
}

enum RatingOutcome {
  WIN
  LOSS
  DRAW
  VOID

  @@map("rating_outcome")
}

enum MatchRatingApplicationStatus {
  APPLIED
  FAILED
  REVERSED

  @@map("match_rating_application_status")
}

enum NotificationType {
  MATCHMAKING_PROPOSAL_CREATED
  MATCHMAKING_PROPOSAL_ACCEPTED
  MATCH_READY_REQUIRED
  MATCH_STARTED
  MATCH_RESULT_WAITING
  MATCH_RESULT_CONFIRMED
  MATCH_RESULT_CONFLICT
  MATCH_DISPUTE_OPENED
  MATCH_DISPUTE_RESPONSE_RECEIVED
  MATCH_DISPUTE_RESOLVED
  MATCH_SETTLEMENT_COMPLETED
  RATING_UPDATED
  SECURITY_SIGN_IN

  @@map("notification_type")
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL

  @@map("notification_priority")
}

enum NotificationChannel {
  IN_APP
  EMAIL

  @@map("notification_channel")
}

enum NotificationOutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  RETRY_SCHEDULED
  FAILED
  DEAD_LETTERED
  CANCELLED

  @@map("notification_outbox_status")
}

enum NotificationDeliveryAttemptStatus {
  SUCCEEDED
  RETRYABLE_FAILURE
  PERMANENT_FAILURE
  SKIPPED

  @@map("notification_delivery_attempt_status")
}

model User {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status                  UserStatus               @default(PENDING_VERIFICATION)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt               DateTime?                @map("deleted_at") @db.Timestamptz(3)
  lastAuthenticatedAt     DateTime?                @map("last_authenticated_at") @db.Timestamptz(3)
  securityVersion         Int                      @default(0) @map("security_version")
  statusChangedAt         DateTime?                @map("status_changed_at") @db.Timestamptz(3)
  suspendedUntil          DateTime?                @map("suspended_until") @db.Timestamptz(3)
  restrictionReasonCode   String?                  @map("restriction_reason_code") @db.VarChar(64)
  restrictionNote         String?                  @map("restriction_note") @db.VarChar(500)
  profile                 UserProfile?
  emails                  UserEmail[]
  phones                  UserPhone[]
  phoneOtpChallenges      PhoneOtpChallenge[]
  mfaTotp                 UserMfaTotp?
  mfaLoginChallenges      MfaLoginChallenge[]
  passwordCredential      PasswordCredential?
  sessions                UserSession[]
  passwordResetTokens     PasswordResetToken[]
  roleAssignments         UserRole[]               @relation("UserRoleSubject")
  rolesAssigned           UserRole[]               @relation("UserRoleActor")
  gameAccounts            UserGameAccount[]
  gameAccountReviews      GameAccountReview[]      @relation("GameAccountReviewActor")
  matchmakingRequests     MatchmakingRequest[]
  rejectedProposals       MatchmakingProposal[]    @relation("MatchmakingProposalRejector")
  matchParticipants       MatchParticipant[]
  matchAuditEvents        MatchAuditEvent[]        @relation("MatchAuditActor")
  resultSubmissions       MatchResultSubmission[]  @relation("MatchResultSubmitter")
  resolvedResults         MatchResult[]            @relation("MatchResultResolver")
  submittedEvidence       MatchEvidence[]          @relation("MatchEvidenceSubmitter")
  openedDisputes          MatchDispute[]           @relation("MatchDisputeOpener")
  assignedDisputes        MatchDispute[]           @relation("MatchDisputeReviewer")
  resolvedDisputes        MatchDispute[]           @relation("MatchDisputeResolver")
  disputeResponses        MatchDisputeResponse[]   @relation("MatchDisputeResponder")
  resultRevisions         MatchResultRevision[]    @relation("MatchResultRevisionActor")
  wallet                  Wallet?
  ledgerTransactions      LedgerTransaction[]      @relation("LedgerTransactionActor")
  walletAuditEvents       WalletAuditEvent[]       @relation("WalletAuditActor")
  matchEntryReservations  MatchEntryReservation[]
  playerRatings           PlayerRating[]
  ratingChanges           PlayerRatingChange[]     @relation("RatingChangeUser")
  opponentRatingChanges   PlayerRatingChange[]     @relation("RatingChangeOpponent")
  ratingApplications      MatchRatingApplication[] @relation("RatingApplicationActor")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  adminAuditEvents        AdminAuditEvent[]        @relation("AdminAuditActor")

  @@index([status], map: "users_status_idx")
  @@index([status, suspendedUntil], map: "users_status_suspended_until_idx")
  @@index([createdAt], map: "users_created_at_idx")
  @@index([deletedAt], map: "users_deleted_at_idx")
  @@map("users")
}

model UserProfile {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @unique(map: "user_profiles_user_id_key") @map("user_id") @db.Uuid
  displayName String   @map("display_name") @db.VarChar(80)
  locale      String   @default("fa") @db.VarChar(5)
  timezone    String   @default("UTC") @db.VarChar(64)
  countryCode String?  @map("country_code") @db.Char(2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "user_profiles_user_id_fkey")

  @@index([countryCode], map: "user_profiles_country_code_idx")
  @@map("user_profiles")
}

model UserEmail {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String                   @map("user_id") @db.Uuid
  email              String                   @db.VarChar(320)
  normalizedEmail    String                   @unique(map: "user_emails_normalized_email_key") @map("normalized_email") @db.VarChar(320)
  isPrimary          Boolean                  @default(false) @map("is_primary")
  verifiedAt         DateTime?                @map("verified_at") @db.Timestamptz(3)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "user_emails_user_id_fkey")
  verificationTokens EmailVerificationToken[]

  @@index([userId], map: "user_emails_user_id_idx")
  @@index([userId, isPrimary], map: "user_emails_user_id_is_primary_idx")
  @@index([verifiedAt], map: "user_emails_verified_at_idx")
  @@map("user_emails")
}

model UserPhone {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  phoneE164     String              @unique(map: "user_phones_phone_e164_key") @map("phone_e164") @db.VarChar(32)
  isPrimary     Boolean             @default(false) @map("is_primary")
  verifiedAt    DateTime?           @map("verified_at") @db.Timestamptz(3)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "user_phones_user_id_fkey")
  otpChallenges PhoneOtpChallenge[]

  @@index([userId], map: "user_phones_user_id_idx")
  @@index([userId, isPrimary], map: "user_phones_user_id_is_primary_idx")
  @@index([verifiedAt], map: "user_phones_verified_at_idx")
  @@map("user_phones")
}

model PhoneOtpChallenge {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String?         @map("user_id") @db.Uuid
  userPhoneId     String?         @map("user_phone_id") @db.Uuid
  phoneE164       String          @map("phone_e164") @db.VarChar(32)
  purpose         PhoneOtpPurpose
  codeHash        String          @map("code_hash") @db.VarChar(128)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt       DateTime        @map("expires_at") @db.Timestamptz(3)
  consumedAt      DateTime?       @map("consumed_at") @db.Timestamptz(3)
  attemptCount    Int             @default(0) @map("attempt_count")
  maxAttempts     Int             @default(5) @map("max_attempts")
  requestedIpHash String?         @map("requested_ip_hash") @db.VarChar(128)
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "phone_otp_challenges_user_id_fkey")
  userPhone       UserPhone?      @relation(fields: [userPhoneId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "phone_otp_challenges_user_phone_id_fkey")

  @@index([userId, purpose, createdAt], map: "phone_otp_challenges_user_purpose_created_idx")
  @@index([userPhoneId], map: "phone_otp_challenges_user_phone_id_idx")
  @@index([expiresAt], map: "phone_otp_challenges_expires_at_idx")
  @@map("phone_otp_challenges")
}

model UserMfaTotp {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String            @unique(map: "user_mfa_totp_user_id_key") @map("user_id") @db.Uuid
  secretCiphertext String            @map("secret_ciphertext") @db.VarChar(1024)
  secretIv         String            @map("secret_iv") @db.VarChar(64)
  secretTag        String            @map("secret_tag") @db.VarChar(64)
  enabledAt        DateTime?         @map("enabled_at") @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "user_mfa_totp_user_id_fkey")
  recoveryCodes    MfaRecoveryCode[]

  @@index([enabledAt], map: "user_mfa_totp_enabled_at_idx")
  @@map("user_mfa_totp")
}

model MfaRecoveryCode {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  totpId     String      @map("totp_id") @db.Uuid
  codeHash   String      @map("code_hash") @db.VarChar(128)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  consumedAt DateTime?   @map("consumed_at") @db.Timestamptz(3)
  totp       UserMfaTotp @relation(fields: [totpId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "mfa_recovery_codes_totp_id_fkey")

  @@unique([totpId, codeHash], map: "mfa_recovery_codes_totp_id_code_hash_key")
  @@index([totpId, consumedAt], map: "mfa_recovery_codes_totp_id_consumed_at_idx")
  @@map("mfa_recovery_codes")
}

model MfaLoginChallenge {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  tokenHash       String    @unique(map: "mfa_login_challenges_token_hash_key") @map("token_hash") @db.VarChar(128)
  securityVersion Int       @map("security_version")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt      DateTime? @map("consumed_at") @db.Timestamptz(3)
  attemptCount    Int       @default(0) @map("attempt_count")
  maxAttempts     Int       @default(5) @map("max_attempts")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "mfa_login_challenges_user_id_fkey")

  @@index([userId, createdAt], map: "mfa_login_challenges_user_id_created_at_idx")
  @@index([expiresAt], map: "mfa_login_challenges_expires_at_idx")
  @@map("mfa_login_challenges")
}

model PasswordCredential {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String    @unique(map: "password_credentials_user_id_key") @map("user_id") @db.Uuid
  passwordHash       String    @map("password_hash") @db.VarChar(512)
  passwordAlgorithm  String    @map("password_algorithm") @db.VarChar(32)
  passwordUpdatedAt  DateTime  @default(now()) @map("password_updated_at") @db.Timestamptz(3)
  failedAttemptCount Int       @default(0) @map("failed_attempt_count")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "password_credentials_user_id_fkey")

  @@index([lockedUntil], map: "password_credentials_locked_until_idx")
  @@map("password_credentials")
}

model UserSession {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  tokenHash        String        @unique(map: "user_sessions_token_hash_key") @map("token_hash") @db.VarChar(128)
  securityVersion  Int           @map("security_version")
  status           SessionStatus @default(ACTIVE)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt       DateTime?     @map("last_seen_at") @db.Timestamptz(3)
  mfaVerifiedAt    DateTime?     @map("mfa_verified_at") @db.Timestamptz(3)
  expiresAt        DateTime      @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime?     @map("revoked_at") @db.Timestamptz(3)
  revocationReason String?       @map("revocation_reason") @db.VarChar(128)
  ipHash           String?       @map("ip_hash") @db.VarChar(128)
  userAgent        String?       @map("user_agent") @db.VarChar(512)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "user_sessions_user_id_fkey")

  @@index([userId], map: "user_sessions_user_id_idx")
  @@index([status], map: "user_sessions_status_idx")
  @@index([expiresAt], map: "user_sessions_expires_at_idx")
  @@index([userId, status], map: "user_sessions_user_id_status_idx")
  @@map("user_sessions")
}

model EmailVerificationToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userEmailId  String    @map("user_email_id") @db.Uuid
  tokenHash    String    @unique(map: "email_verification_tokens_token_hash_key") @map("token_hash") @db.VarChar(128)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(3)
  attemptCount Int       @default(0) @map("attempt_count")
  userEmail    UserEmail @relation(fields: [userEmailId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "email_verification_tokens_user_email_id_fkey")

  @@index([userEmailId], map: "email_verification_tokens_user_email_id_idx")
  @@index([expiresAt], map: "email_verification_tokens_expires_at_idx")
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  tokenHash       String    @unique(map: "password_reset_tokens_token_hash_key") @map("token_hash") @db.VarChar(128)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt      DateTime? @map("consumed_at") @db.Timestamptz(3)
  requestedIpHash String?   @map("requested_ip_hash") @db.VarChar(128)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "password_reset_tokens_user_id_fkey")

  @@index([userId], map: "password_reset_tokens_user_id_idx")
  @@index([expiresAt], map: "password_reset_tokens_expires_at_idx")
  @@map("password_reset_tokens")
}

model Role {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String           @unique(map: "roles_key_key") @db.VarChar(64)
  name        String           @db.VarChar(100)
  description String?          @db.VarChar(500)
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String           @unique(map: "permissions_key_key") @db.VarChar(100)
  description String?          @db.VarChar(500)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId           String    @map("user_id") @db.Uuid
  roleId           String    @map("role_id") @db.Uuid
