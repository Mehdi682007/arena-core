}

model NotificationOutboxMessage {
  id               String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId   String                        @map("notification_id") @db.Uuid
  channel          NotificationChannel
  status           NotificationOutboxStatus      @default(PENDING)
  deduplicationKey String                        @unique(map: "notification_outbox_deduplication_key") @map("deduplication_key") @db.VarChar(96)
  availableAt      DateTime                      @map("available_at") @db.Timestamptz(3)
  attemptCount     Int                           @default(0) @map("attempt_count")
  lastAttemptAt    DateTime?                     @map("last_attempt_at") @db.Timestamptz(3)
  deliveredAt      DateTime?                     @map("delivered_at") @db.Timestamptz(3)
  failedAt         DateTime?                     @map("failed_at") @db.Timestamptz(3)
  deadLetteredAt   DateTime?                     @map("dead_lettered_at") @db.Timestamptz(3)
  lastErrorCode    String?                       @map("last_error_code") @db.VarChar(64)
  payloadSnapshot  Json                          @map("payload_snapshot")
  claimToken       String?                       @map("claim_token") @db.Uuid
  claimExpiresAt   DateTime?                     @map("claim_expires_at") @db.Timestamptz(3)
  version          Int                           @default(1)
  createdAt        DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)
  notification     Notification                  @relation(fields: [notificationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "notification_outbox_notification_id_fkey")
  deliveryAttempts NotificationDeliveryAttempt[]

  @@unique([notificationId, channel], map: "notification_outbox_notification_channel_key")
  @@index([status, availableAt, id], map: "notification_outbox_status_available_idx")
  @@index([channel, status], map: "notification_outbox_channel_status_idx")
  @@index([deliveredAt], map: "notification_outbox_delivered_idx")
  @@index([deadLetteredAt], map: "notification_outbox_dead_lettered_idx")
  @@index([createdAt], map: "notification_outbox_created_idx")
  @@index([claimExpiresAt], map: "notification_outbox_claim_expires_idx")
  @@map("notification_outbox_messages")
}

model NotificationDeliveryAttempt {
  id                String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outboxMessageId   String                            @map("outbox_message_id") @db.Uuid
  attemptNumber     Int                               @map("attempt_number")
  status            NotificationDeliveryAttemptStatus
  provider          String                            @db.VarChar(64)
  providerMessageId String?                           @map("provider_message_id") @db.VarChar(255)
  errorCode         String?                           @map("error_code") @db.VarChar(64)
  errorCategory     String?                           @map("error_category") @db.VarChar(32)
  startedAt         DateTime                          @map("started_at") @db.Timestamptz(3)
  completedAt       DateTime                          @map("completed_at") @db.Timestamptz(3)
  createdAt         DateTime                          @default(now()) @map("created_at") @db.Timestamptz(3)
  outboxMessage     NotificationOutboxMessage         @relation(fields: [outboxMessageId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "notification_delivery_attempts_outbox_id_fkey")

  @@unique([outboxMessageId, attemptNumber], map: "notification_delivery_attempts_outbox_number_key")
  @@index([status, createdAt], map: "notification_delivery_attempts_status_created_idx")
  @@map("notification_delivery_attempts")
}

