# Safe local-development example. Never add secrets to this file.
NODE_ENV=development
APP_ENV=local
APP_VERSION=0.0.0
LOG_LEVEL=debug
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001/api/v1
WEB_BASE_URL=http://localhost:3000
TRUST_PROXY_MODE=none
ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_NO_ORIGIN=true
COOKIE_SECURE=false
RATE_LIMIT_ENABLED=true
MIGRATION_MODE=external
HTTP_BODY_LIMIT_BYTES=16384
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000
HSTS_ENABLED=false
HSTS_INCLUDE_SUBDOMAINS=false
EXPOSE_ERROR_DETAILS=true
DEBUG_ROUTES_ENABLED=false
HOST=127.0.0.1
WEB_PORT=3000
NEXT_PUBLIC_APP_NAME=Arena Core
NEXT_PUBLIC_DEFAULT_LOCALE=fa
API_PORT=3001
API_PREFIX=/api/v1
CORS_ENABLED=false
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000
WORKER_SHUTDOWN_TIMEOUT_MS=10000

# Prisma remains disabled until a server process explicitly enables it.
DATABASE_ENABLED=false
DATABASE_URL=postgresql://arena_core:arena_core_dev_only@127.0.0.1:5432/arena_core?schema=public
DATABASE_DIRECT_URL=postgresql://arena_core:arena_core_dev_only@127.0.0.1:5432/arena_core?schema=public
DATABASE_LOG_QUERIES=false
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Authentication defaults are development-only. Replace both hash keys with
# independent high-entropy secrets in every deployed environment.
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
PASSWORD_HASH_ALGORITHM=argon2id
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1
SESSION_TOKEN_BYTES=32
SESSION_TTL_SECONDS=2592000
SESSION_IDLE_TIMEOUT_SECONDS=604800
SESSION_TOUCH_INTERVAL_SECONDS=300
EMAIL_VERIFICATION_TOKEN_BYTES=32
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TOKEN_BYTES=32
PASSWORD_RESET_TTL_SECONDS=3600
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900
AUTH_TOKEN_HASH_KEY=development-only-token-hash-key-32-bytes-minimum
AUTH_IP_HASH_KEY=development-only-ip-hash-key-32-bytes-minimum

# Identity HTTP (server-only)
SESSION_COOKIE_NAME=arena_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_PATH=/
# SESSION_COOKIE_DOMAIN=example.com
SESSION_COOKIE_MAX_AGE_SECONDS=2592000
AUTH_ALLOWED_ORIGINS=http://localhost:3000
AUTH_REQUIRE_ORIGIN=false
AUTH_MAX_REQUEST_BODY_BYTES=16384
AUTH_RATE_LIMIT_LOGIN_MAX=5
AUTH_RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REGISTER_MAX=5
AUTH_RATE_LIMIT_REGISTER_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_TOKEN_MAX=10
AUTH_RATE_LIMIT_TOKEN_WINDOW_SECONDS=300

# Email delivery — development-only Mailpit defaults. Use a real TLS SMTP provider in production.
SMTP_ENABLED=false
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@arena-core.local
SMTP_FROM_NAME=Arena Core
SMTP_REPLY_TO_ADDRESS=
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_GREETING_TIMEOUT_MS=5000
SMTP_SOCKET_TIMEOUT_MS=10000

# Identity email links — server-only
IDENTITY_PUBLIC_BASE_URL=http://localhost:3000
IDENTITY_EMAIL_DEFAULT_LOCALE=fa
IDENTITY_EMAIL_VERIFICATION_PATH=/verify-email
IDENTITY_PASSWORD_RESET_PATH=/reset-password
IDENTITY_EMAIL_DELIVERY_REQUIRED=false
IDENTITY_EMAIL_APP_NAME=Arena Core

# Local Docker Compose infrastructure. Credentials are intentionally insecure,
# development-only examples and must never be reused in staging or production.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=arena_core
POSTGRES_USER=arena_core
POSTGRES_PASSWORD=arena_core_dev_only

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

MINIO_HOST=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=arena_core
MINIO_ROOT_PASSWORD=arena_core_dev_only
MINIO_EVIDENCE_BUCKET=match-evidence

MAILPIT_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MATCH_READY_TTL_SECONDS=120
MATCH_ENTRY_RESERVATION_TTL_SECONDS=300
MATCH_SETTLEMENT_DELAY_SECONDS=86400
MATCH_RESULT_SUBMISSION_TTL_SECONDS=3600
MATCH_RESULT_CONFLICT_RESOLUTION_TTL_SECONDS=86400
MATCH_EVIDENCE_SUBMISSION_TTL_SECONDS=86400
MATCH_DISPUTE_OPEN_TTL_SECONDS=86400
MATCH_DISPUTE_RESPONSE_TTL_SECONDS=86400
MATCH_DISPUTE_REVIEW_TTL_SECONDS=259200
RATING_INITIAL_VALUE=1000
RATING_PROVISIONAL_MATCH_COUNT=10
RATING_PROVISIONAL_K_FACTOR=40
RATING_ESTABLISHED_K_FACTOR=24
RATING_MINIMUM_VALUE=100
RATING_MAXIMUM_VALUE=3000
MATCH_RATING_DELAY_SECONDS=86400
LEADERBOARD_MIN_MATCHES_PLAYED=1
NOTIFICATION_DELIVERY_MAX_ATTEMPTS=5
NOTIFICATION_DELIVERY_RETRY_BASE_SECONDS=60
NOTIFICATION_DELIVERY_RETRY_MAX_SECONDS=3600
NOTIFICATION_OUTBOX_CLAIM_LEASE_SECONDS=60
