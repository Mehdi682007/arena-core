# Staging policy mirrors production. Replace every REQUIRED value before startup.
APP_ENV=staging
NODE_ENV=production
APP_BASE_URL=https://staging.example.invalid
ADMIN_ORIGIN=https://admin.staging.example.invalid
ADMIN_DOMAIN=admin.staging.example.invalid
API_BASE_URL=https://api.staging.example.invalid
WEB_BASE_URL=https://staging.example.invalid
AUTH_ALLOWED_ORIGINS=https://staging.example.invalid,https://admin.staging.example.invalid
SESSION_SECRET=REQUIRED_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
CSRF_SECRET=REQUIRED_DIFFERENT_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
DATABASE_ENABLED=true
DATABASE_URL=postgresql://REQUIRED_USER:REQUIRED_PASSWORD@REQUIRED_HOST/REQUIRED_DATABASE
DATABASE_DIRECT_URL=postgresql://REQUIRED_USER:REQUIRED_PASSWORD@REQUIRED_HOST/REQUIRED_DATABASE
SMTP_ENABLED=false
TRUST_PROXY_MODE=hop-count
TRUST_PROXY_HOPS=1
ALLOWED_ORIGINS=https://staging.example.invalid,https://admin.staging.example.invalid
CORS_ALLOW_NO_ORIGIN=true
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
SESSION_COOKIE_NAME=__Host-arena_session
RATE_LIMIT_ENABLED=true
MIGRATION_MODE=external
LOG_LEVEL=info
HTTP_BODY_LIMIT_BYTES=16384
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000
HSTS_ENABLED=true
HSTS_INCLUDE_SUBDOMAINS=false
EXPOSE_ERROR_DETAILS=false
DEBUG_ROUTES_ENABLED=false
# Compose release identity (never use a mutable tag):
BUILD_SHA=REQUIRED_RELEASE_COMMIT_SHA
RELEASE_VERSION=REQUIRED_SEMANTIC_VERSION
IMAGE_NAMESPACE=REQUIRED_REGISTRY_NAMESPACE
IMAGE_TAG=REQUIRED_VERSION_DASH_SHORT_SHA
