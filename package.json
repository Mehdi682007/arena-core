{
  "name": "arena-core",
  "version": "0.1.0-rc.1",
  "private": true,
  "description": "Game-agnostic competition platform monorepo (working name: Arena Core).",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.14.0 <25",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "clean": "turbo run clean && rimraf .turbo",
    "db:format": "pnpm --filter @arena-core/database db:format",
    "db:generate": "pnpm --filter @arena-core/database db:generate",
    "db:migrate:create": "pnpm --filter @arena-core/database db:migrate:create",
    "db:migrate:deploy": "pnpm --filter @arena-core/database db:migrate:deploy",
    "db:migrate:dev": "pnpm --filter @arena-core/database db:migrate:dev",
    "db:migrate:reset": "pnpm --filter @arena-core/database db:migrate:reset",
    "db:migrate:status": "pnpm --filter @arena-core/database db:migrate:status",
    "db:pull": "pnpm --filter @arena-core/database db:pull",
    "db:seed": "pnpm --filter @arena-core/game-catalog db:seed",
    "db:seed:fc26": "pnpm --filter @arena-core/game-catalog db:seed:fc26",
    "db:seed:validate": "pnpm --filter @arena-core/game-catalog db:seed:validate",
    "admin:bootstrap": "pnpm --filter @arena-core/game-catalog admin:bootstrap",
    "db:studio": "pnpm --filter @arena-core/database db:studio",
    "db:validate": "pnpm --filter @arena-core/database db:validate",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --write apps/web/src/features/settings/password-change-form.tsx apps/web/src/features/settings/profile-form.tsx apps/web/src/i18n/messages.ts packages/identity/src/application/identity-services.ts && git diff -- apps/web/src/features/settings/password-change-form.tsx apps/web/src/features/settings/profile-form.tsx apps/web/src/i18n/messages.ts packages/identity/src/application/identity-services.ts && exit 1",
    "infra:config": "docker compose --project-directory . -f infra/compose/docker-compose.yml config --quiet",
    "infra:down": "docker compose --project-directory . -f infra/compose/docker-compose.yml down --remove-orphans",
    "infra:health": "node infra/compose/health.mjs",
    "infra:logs": "docker compose --project-directory . -f infra/compose/docker-compose.yml logs --follow",
    "infra:logs:mailpit": "docker compose --project-directory . -f infra/compose/docker-compose.yml logs --follow mailpit",
    "infra:logs:minio": "docker compose --project-directory . -f infra/compose/docker-compose.yml logs --follow minio minio-init",
    "infra:logs:postgres": "docker compose --project-directory . -f infra/compose/docker-compose.yml logs --follow postgres",
    "infra:logs:redis": "docker compose --project-directory . -f infra/compose/docker-compose.yml logs --follow redis",
    "infra:pull": "docker compose --project-directory . -f infra/compose/docker-compose.yml pull",
    "infra:reset": "docker compose --project-directory . -f infra/compose/docker-compose.yml down --volumes --remove-orphans",
    "infra:restart": "docker compose --project-directory . -f infra/compose/docker-compose.yml restart",
    "infra:status": "docker compose --project-directory . -f infra/compose/docker-compose.yml ps --all",
    "infra:up": "docker compose --project-directory . -f infra/compose/docker-compose.yml up --detach",
    "lint": "turbo run lint && eslint eslint.config.mjs prettier.config.mjs packages/eslint-config/*.mjs infra/compose/*.mjs infra/release/*.mjs scripts/**/*.mjs docker/healthchecks/*.mjs",
    "release:manifest": "node scripts/release/generate-manifest.mjs",
    "release:preflight": "node scripts/release/preflight.mjs",
    "release:preflight:full": "node scripts/release/preflight.mjs --full",
    "release:smoke": "node scripts/release/smoke.mjs",
    "release:verify": "node scripts/release/verify-artifacts.mjs",
    "db:backup": "node scripts/database/backup.mjs",
    "db:restore": "node scripts/database/restore.mjs",
    "test": "turbo run test && node --test infra/automation.test.mjs infra/compose/health.test.mjs infra/release/artifacts.test.mjs tests/product-integration.test.mjs",
    "typecheck": "turbo run typecheck && tsc --build"
  },
  "devDependencies": {
    "@arena-core/eslint-config": "workspace:*",
    "@arena-core/typescript-config": "workspace:*",
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
