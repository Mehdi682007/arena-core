# Template only. It is intentionally not directly deployable.
APP_ENV=production
NODE_ENV=production
APP_BASE_URL=https://REQUIRED_PUBLIC_HOST
ADMIN_ORIGIN=https://REQUIRED_ADMIN_HOST
ADMIN_DOMAIN=REQUIRED_ADMIN_HOST
API_BASE_URL=https://REQUIRED_API_HOST
WEB_BASE_URL=https://REQUIRED_WEB_HOST
AUTH_ALLOWED_ORIGINS=https://REQUIRED_WEB_HOST,https://REQUIRED_ADMIN_HOST
SESSION_SECRET=REQUIRED_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
CSRF_SECRET=REQUIRED_DIFFERENT_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
DATABASE_ENABLED=true
DATABASE_URL=postgresql://REQUIRED_USER:REQUIRED_PASSWORD@REQUIRED_HOST/REQUIRED_DATABASE
DATABASE_DIRECT_URL=postgresql://REQUIRED_USER:REQUIRED_PASSWORD@REQUIRED_HOST/REQUIRED_DATABASE
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD_FILE=/run/arena-secrets/SMTP_PASSWORD
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_FROM_NAME=Arena Core
# When SMTP_ENABLED=true: SMTP_HOST, SMTP_PORT, SMTP_USERNAME, SMTP_PASSWORD and SMTP_FROM_ADDRESS are required.
TRUST_PROXY_MODE=hop-count
TRUST_PROXY_HOPS=1
ALLOWED_ORIGINS=https://REQUIRED_WEB_HOST,https://REQUIRED_ADMIN_HOST
CORS_ALLOW_NO_ORIGIN=true
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
SESSION_COOKIE_NAME=__Host-arena_session
RATE_LIMIT_ENABLED=true
MIGRATION_MODE=external
LOG_LEVEL=info
HTTP_BODY_LIMIT_BYTES=16384
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000
HSTS_ENABLED=true
HSTS_INCLUDE_SUBDOMAINS=false
EXPOSE_ERROR_DETAILS=false
DEBUG_ROUTES_ENABLED=false
# Immutable release/container metadata:
BUILD_SHA=REQUIRED_RELEASE_COMMIT_SHA
RELEASE_VERSION=REQUIRED_SEMANTIC_VERSION
IMAGE_NAMESPACE=REQUIRED_REGISTRY_NAMESPACE
IMAGE_TAG=REQUIRED_VERSION_DASH_SHORT_SHA
# Conservative defaults; tune from staging measurements:
API_MEMORY_LIMIT=512m
API_CPU_LIMIT=1.0
WORKER_MEMORY_LIMIT=384m
WORKER_CPU_LIMIT=0.75
WEB_MEMORY_LIMIT=512m
WEB_CPU_LIMIT=1.0
MIGRATE_MEMORY_LIMIT=512m
MIGRATE_CPU_LIMIT=1.0
