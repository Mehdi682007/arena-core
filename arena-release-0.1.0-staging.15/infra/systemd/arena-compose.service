[Unit]
Description=Arena Compose application
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/arena/scripts/start
ExecStop=/opt/arena/scripts/stop
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
# Deliberately disabled until F10.2 validates environment and secrets.
