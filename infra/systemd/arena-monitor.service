[Unit]
Description=Arena Core operational health monitor
After=docker.service nginx.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/arena/monitoring.env
ExecStart=/opt/arena/current/infra/scripts/monitor.sh
TimeoutStartSec=2m
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/arena-monitor
