server {
  listen 80;
  listen [::]:80;
  server_name {{APP_DOMAIN}};
  client_max_body_size 10m;

  location = /admin { return 404; }
  location ^~ /admin/ { return 404; }
  location ^~ /api/backend/ {
    proxy_pass http://127.0.0.1:{{WEB_PORT}};
    include /etc/nginx/proxy_params;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
  }
  location /api/ {
    proxy_pass http://127.0.0.1:{{API_PORT}};
    include /etc/nginx/proxy_params;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
  }
  location / {
    proxy_pass http://127.0.0.1:{{WEB_PORT}};
    include /etc/nginx/proxy_params;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
  }
}

server {
  listen 80;
  listen [::]:80;
  server_name {{ADMIN_DOMAIN}};
  access_log /var/log/nginx/arena-admin-access.log;
  error_log /var/log/nginx/arena-admin-error.log;
  client_max_body_size 10m;

  location = / { return 302 /admin; }
  location ^~ /api/backend/ {
    proxy_pass http://127.0.0.1:{{WEB_PORT}};
    include /etc/nginx/proxy_params;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
  }
  location /api/ {
    proxy_pass http://127.0.0.1:{{API_PORT}};
    include /etc/nginx/proxy_params;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
  }
  location / {
    proxy_pass http://127.0.0.1:{{WEB_PORT}};
    include /etc/nginx/proxy_params;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
  }
}

server {
  listen 127.0.0.1:8088;
  server_name localhost;
  access_log off;
  location = /arena-proxy-health { default_type text/plain; return 200 "ok\n"; }
  location / { return 404; }
}

# Certbot must issue one certificate for {{APP_DOMAIN}} and {{ADMIN_DOMAIN}}, then
# install HTTPS redirects. The deployment runbook contains the bounded command.
