APP_ENV=staging
NODE_ENV=production
APP_BASE_URL=http://192.0.2.10
WEB_BASE_URL=http://192.0.2.10
API_BASE_URL=http://192.0.2.10/api
DATABASE_ENABLED=true
DATABASE_URL=postgresql://placeholder:placeholder@postgres:5432/arena_validation
DATABASE_DIRECT_URL=postgresql://placeholder:placeholder@postgres:5432/arena_validation
SESSION_SECRET=VALIDATION_PLACEHOLDER_NOT_A_SECRET
CSRF_SECRET=VALIDATION_PLACEHOLDER_NOT_A_SECRET
AUTH_TOKEN_HASH_KEY=VALIDATION_PLACEHOLDER_NOT_A_SECRET
AUTH_IP_HASH_KEY=VALIDATION_PLACEHOLDER_NOT_A_SECRET
SMTP_ENABLED=false
TRUST_PROXY_MODE=hop-count
TRUST_PROXY_HOPS=1
ALLOWED_ORIGINS=http://192.0.2.10
CORS_ALLOW_NO_ORIGIN=false
COOKIE_SECURE=false
RATE_LIMIT_ENABLED=true
MIGRATION_MODE=external
BUILD_SHA=uncommitted
RELEASE_VERSION=0.1.0-rc.1
