# Non-secret automation inventory. Copy outside version control before use.
ENVIRONMENT=staging
SERVER_HOST=
SERVER_SSH_PORT=22
SERVER_INITIAL_USER=
SERVER_OPERATOR_USER=arena
SERVER_APP_USER=arenaapp
SERVER_APP_ROOT=/opt/arena
SERVER_BACKUP_ROOT=/opt/arena/backups
OPERATOR_PUBLIC_KEY_FILE=
APP_DOMAIN=
APP_HTTP_PORT=80
ENABLE_TLS=false
ENABLE_UFW=true
ENABLE_FAIL2BAN=true
ENABLE_UNATTENDED_UPDATES=true
ENABLE_SWAP=true
SWAP_SIZE_GB=2
SSH_ALLOW_TCP_FORWARDING=false
OPERATOR_DOCKER_GROUP=false
POSTGRES_MODE=container
POSTGRES_DB=arena_core
POSTGRES_USER=arena_core
DEPLOY_MODE=prebuilt
REGISTRY_USERNAME=
REGISTRY_TOKEN_FILE=
RELEASE_VERSION=0.1.0-rc.1
RELEASE_ARCHIVE=
ALLOW_SUPPORTED_OS_OVERRIDE=false
