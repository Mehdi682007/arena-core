# Non-secret automation inventory. Domain and TLS are mandatory in production.
ENVIRONMENT=production
SERVER_HOST=
SERVER_SSH_PORT=22
SERVER_INITIAL_USER=
SERVER_OPERATOR_USER=arena
SERVER_APP_USER=arenaapp
SERVER_APP_ROOT=/opt/arena
SERVER_BACKUP_ROOT=/opt/arena/backups
OPERATOR_PUBLIC_KEY_FILE=
APP_DOMAIN=
ADMIN_DOMAIN=
APP_HTTP_PORT=80
ENABLE_TLS=true
ENABLE_UFW=true
ENABLE_FAIL2BAN=true
ENABLE_UNATTENDED_UPDATES=true
ENABLE_SWAP=false
SWAP_SIZE_GB=2
SSH_ALLOW_TCP_FORWARDING=false
OPERATOR_DOCKER_GROUP=false
POSTGRES_MODE=external
POSTGRES_DB=arena_core
POSTGRES_USER=arena_core
DEPLOY_MODE=prebuilt
REGISTRY_USERNAME=
REGISTRY_TOKEN_FILE=
RELEASE_VERSION=
RELEASE_ARCHIVE=
RELEASE_ARCHIVE_SHA256=
ALLOW_SUPPORTED_OS_OVERRIDE=false
