PUBLIC_ORIGIN=https://app.example.com
ADMIN_ORIGIN=https://admin.example.com
ARENA_INVENTORY_FILE=/etc/arena/production.env
DISK_WARNING_PERCENT=80
DISK_CRITICAL_PERCENT=90
INODE_WARNING_PERCENT=80
INODE_CRITICAL_PERCENT=90
TLS_EXPIRY_WARNING_DAYS=21
BACKUP_MAX_AGE_HOURS=36
CONTAINER_RESTART_WARNING=1
BACKUP_RETENTION_DAYS=14
BACKUP_CLEANUP_LIMIT=100
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN_FILE=/opt/arena/shared/secrets/TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID_FILE=/opt/arena/shared/secrets/TELEGRAM_CHAT_ID
